# Caniné Ritual — variables de entorno (Fase posterior; aún no requeridas para build/test).
# OAuth Authorization Code + PKCE (clientes públicos, sin client secret).

# Spotify (dev mode: hasta 5 usuarios Premium en allowlist)
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:3001/callback

# YouTube / Google (login opcional)
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_REDIRECT_URI=http://localhost:3001/callback
